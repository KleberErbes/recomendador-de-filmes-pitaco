# Copie este arquivo para ".env" e preencha com as SUAS chaves.
# O arquivo .env é ignorado pelo git (ver .gitignore) — suas chaves não vão para o repositório.
#
# Na Vercel, essas mesmas variáveis vão em: Settings → Environment Variables.

# Chave da Anthropic (https://console.anthropic.com/ → API Keys)
ANTHROPIC_API_KEY=coloque_sua_chave_anthropic_aqui

# Chave v3 do TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=coloque_sua_chave_tmdb_aqui
